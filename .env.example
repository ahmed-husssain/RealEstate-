# Database Connection URL (Server-side only)
# PostgreSQL connection string for Prisma ORM
DATABASE_URL="postgresql://username:password@localhost:5432/amber_realestate?schema=public"

# Admin Authentication & Session Security (Server-side only)
# Minimum 32 characters high-entropy secret string for signing HMAC session cookies
ADMIN_SESSION_SECRET="change-to-a-secure-random-32-character-secret-key-for-session-signing"

# Initial Super Admin Seeding Credentials (Server-side only, used by prisma/seed-admin.ts)
ADMIN_INITIAL_EMAIL="admin@example.com"
ADMIN_INITIAL_PASSWORD="your-strong-temporary-password-min-8-chars"
ADMIN_INITIAL_NAME="Managing Director | Amber Property"
