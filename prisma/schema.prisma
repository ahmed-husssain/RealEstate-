datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --------------------------------------------------------
// Enums
// --------------------------------------------------------

enum AdminRole {
  ADMIN
  USER
}

enum PropertyStatus {
  FOR_SALE
  FOR_LEASE
  EXCLUSIVE
  UNDER_OFFER
  SOLD
}

enum PropertyType {
  HOUSE
  APARTMENT
  PENTHOUSE
  VILLA
  PLOT
  COMMERCIAL
  ESTATE
  TOWNHOUSE
  PORTION
}

enum AreaUnit {
  SQFT
  SQYD
  MARLA
  KANAL
}

enum PropertyCondition {
  BRAND_NEW
  EXCELLENT
  GOOD
  NEEDS_RENOVATION
  UNDER_CONSTRUCTION
}

enum InquiryType {
  VIEWING
  GENERAL
  VALUATION
  CALL_REQUEST
}

enum InquiryStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  CLOSED
  ARCHIVED
}

enum ValuationStatus {
  PENDING
  ESTIMATED
  CONTACTED
  COMPLETED
}

// --------------------------------------------------------
// Models
// --------------------------------------------------------

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(USER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@map("admin_users")
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  category  String   @default("general") // general, hero, contact, announcements
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([category])
  @@map("site_settings")
}

model Property {
  id            String         @id @default(cuid())
  slug          String         @unique
  title         String
  tagline       String?
  description   String         @db.Text
  price         Decimal        @db.Decimal(14, 2)
  priceFormatted String?
  priceSuffix   String?
  priceType     String         @default("TOTAL")
  status        PropertyStatus @default(FOR_SALE)
  isFeatured    Boolean        @default(false)
  propertyType  PropertyType   @default(HOUSE)
  bedrooms      Int            @default(0)
  bathrooms     Int            @default(0)
  areaSize      Decimal        @db.Decimal(10, 2)
  areaUnit      AreaUnit       @default(SQYD)
  lotSize       Decimal?       @db.Decimal(10, 2)
  lotSizeUnit   AreaUnit?      @default(SQYD)
  yearBuilt     Int?
  parkingSpaces Int            @default(0)
  energyRating  String?
  floorLevel    String?
  condition     PropertyCondition @default(GOOD)
  address       String
  postalCode    String?
  latitude      Decimal?       @db.Decimal(10, 7)
  longitude     Decimal?       @db.Decimal(10, 7)
  amenities     String[]       @default([])
  virtualTourUrl String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relationships
  areaId        String
  area          Area           @relation(fields: [areaId], references: [id], onDelete: Cascade)
  agentId       String?
  agent         Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  images        PropertyImage[]
  inquiries     Inquiry[]

  // Indexes for high-performance filtering
  @@index([areaId])
  @@index([status])
  @@index([propertyType])
  @@index([isFeatured])
  @@index([price])
  @@index([createdAt])
}

model PropertyImage {
  id           String   @id @default(cuid())
  propertyId   String
  url          String
  publicId     String?
  alt          String?
  isHero       Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  // Relationships
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([propertyId])
  @@index([displayOrder])
}

model Area {
  id                 String     @id @default(cuid())
  slug               String     @unique
  name               String
  city               String     @default("Karachi")
  tagline            String?
  description        String     @db.Text
  heroImage          String
  heroImagePublicId  String?
  avgPriceSqYd       String?    @default("PKR 150,000 / Sq Yd")
  annualGrowth       String?    @default("+12.5%")
  isPopular          Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // Relationships
  properties Property[]

  // Indexes
  @@index([slug])
  @@index([city])
}

model Agent {
  id              String     @id @default(cuid())
  name            String
  role            String?
  phone           String
  email           String     @unique
  whatsapp        String?
  avatarUrl       String
  experienceYears Int        @default(5)
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relationships
  properties Property[]

  // Indexes
  @@index([email])
  @@index([isActive])
}

model Inquiry {
  id            String        @id @default(cuid())
  propertyId    String?
  type          InquiryType   @default(GENERAL)
  name          String
  phone         String
  email         String
  preferredDate String?
  timeSlot      String?
  message       String?       @db.Text
  status        InquiryStatus @default(NEW)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relationships
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  // Indexes
  @@index([propertyId])
  @@index([status])
  @@index([createdAt])
}

model ValuationRequest {
  id           String            @id @default(cuid())
  propertyType PropertyType
  areaName     String
  areaSize     Decimal           @db.Decimal(10, 2)
  areaUnit     AreaUnit          @default(SQYD)
  bedrooms     Int               @default(0)
  bathrooms    Int               @default(0)
  condition    PropertyCondition @default(GOOD)
  ownerName    String
  ownerPhone   String
  ownerEmail   String
  estimatedMin Decimal?          @db.Decimal(14, 2)
  estimatedMax Decimal?          @db.Decimal(14, 2)
  status       ValuationStatus   @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  // Indexes
  @@index([status])
  @@index([createdAt])
}
